{
  "name": "webp-converter",
  "displayName": "WebP Converter",
  "description": "Convert images to WebP format with quality preview",
  "version": "1.0.0",
  "publisher": "kjokkenkoddinger",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "webp-converter.convertToWebP",
        "title": "Convert to WebP"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname =~ /\\.(png|jpg|jpeg|gif|bmp|tiff)$/i",
          "command": "webp-converter.convertToWebP",
          "group": "2_workspace"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node esbuild.config.js --production",
    "package:dev": "node esbuild.config.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\""
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/omggif": "^1.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "esbuild": "^0.27.1",
    "eslint": "^8.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "bmp-js": "^0.1.0",
    "decode-ico": "^0.4.1",
    "jpeg-js": "^0.4.4",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "utif": "^3.1.0",
    "webp-wasm": "^1.0.6"
  }
}
